# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017/sorokwugana
# Cloud (Atlas): Get from Atlas → Connect → Drivers
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sorokwugana

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Admin seed credentials ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_password

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Email / SMTP (Nodemailer) ─────────────────────────────────────────────────
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# Sender display name
EMAIL_FROM_NAME=SoroKwuGana

# ── Site URL ──────────────────────────────────────────────────────────────────
# Set to your real domain when deployed
SITE_URL=http://localhost:5173
