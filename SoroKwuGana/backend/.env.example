# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas (Cloud) — direct connection avoids SRV DNS issues on Windows
# Get these values from Atlas → Connect → Drivers
MONGODB_URI=mongodb://<username>:<password>@ac-xxxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-02.xxxxx.mongodb.net:27017/sorokwugana?authSource=admin&replicaSet=atlas-xxxxx-shard-0&tls=true&retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin seed credentials
ADMIN_EMAIL=sorokwugana@gmail.com
ADMIN_PASSWORD=sorokwugana1206

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Newsletter / Email (Nodemailer) ─────────────────────────────────────────
# Gmail SMTP: use an App Password from https://myaccount.google.com/apppasswords
# Other providers: update SMTP_HOST and SMTP_PORT accordingly
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=destinyorji18@gmail.com
SMTP_PASS=desf vfaq invx kfig

# Sender display name
EMAIL_FROM_NAME=SoroKwuGana

# Public URL of the frontend (used in email links)
SITE_URL=http://localhost:5173
