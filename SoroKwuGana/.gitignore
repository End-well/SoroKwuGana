# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
**/dist/
dist-ssr/
build/
**/build/
out/
**/out/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
**/*.tsbuildinfo

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Package manager locks (keep only one — we use npm) ───────────────────────
yarn.lock
pnpm-lock.yaml

# ── Vite / frontend cache ─────────────────────────────────────────────────────
.vite/
**/.vite/
*.local

# ── Prisma ────────────────────────────────────────────────────────────────────
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/migrations/dev/

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
Desktop.ini

# ── Editor & IDE ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.local
.cache/
**/.cache/
tmp/
temp/

# ── Stale artifact from old apps/ structure ───────────────────────────────────
apps/
